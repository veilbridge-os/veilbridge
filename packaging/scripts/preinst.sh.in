#!/bin/sh
# Runs before this package's files are written.
#
#   opkg  → preinst
#   apk   → .pre-install (fresh) and .pre-upgrade (package already installed)
#
# Why this file exists: the package is architecture-independent on purpose (see
# packaging/nfpm.yaml), because both package managers use per-subtarget
# architecture names (`aarch64_cortex-a53` in /etc/apk/arch on the test router),
# so a real arch string would be refused on every other ARM device. The CPU is
# therefore ours to check.
#
# The two package managers behave very differently when this script fails, and
# both were measured on a Cudy WR3000S v1 (aarch64):
#
#   opkg (24.10.8): refusal works. preinst runs before any data file is
#     extracted and a non-zero exit aborts the install
#     (libopkg/opkg_install.c: preinst_configure() → "Aborting installation").
#     But opkg never undoes the old package's prerm — its unwind hook
#     prerm_upgrade_old_pkg_unwind() is a stub returning 0 — so the service it
#     stopped stays down unless we start it again ourselves.
#
#   apk-tools 3.0.5 (25.12.5): refusal is impossible. The script is executed
#     from inside the extraction loop (apk_db_install_archive_entry() →
#     apk_db_run_pending_script()), its return value is discarded, a failure
#     only sets ipkg->broken_script, and `apk add` still exits 0. Measured: the
#     x86 binary replaced the working arm64 one anyway.
#
# So this script does two things instead of just refusing: it refuses (which
# opkg honours), and it saves the working binary so postinst can put it back
# (which is what saves the day under apk). The copy goes to /tmp — tmpfs, so a
# 15 MB rescue copy costs RAM for one transaction instead of a quarter of the
# overlay.
#
# @VB_ARCH@ is substituted at build time from VB_ARCH, so the package knows
# which CPU its binary was built for without unpacking anything.
set -e

PKG_ARCH='@VB_ARCH@'
BIN=/usr/bin/veilbridged
MARK=/tmp/veilbridge.was-running
RESCUE=/tmp/veilbridge.rescue-bin

# Put back what the old package's prerm stopped (opkg path; apk does not run
# deinstall scripts on upgrade). The marker only exists once the *installed*
# package is new enough to write it, so fall back to the autostart flag, which
# prerm keeps during an upgrade and drops only on a real uninstall.
resume_old_service() {
	had_marker=0
	if [ -f "$MARK" ]; then
		had_marker=1
		rm -f "$MARK"
	fi

	[ -x /etc/init.d/veilbridge ] || return 0
	/etc/init.d/veilbridge running >/dev/null 2>&1 && return 0

	if [ "$had_marker" = 0 ] &&
		! /etc/init.d/veilbridge enabled >/dev/null 2>&1; then
		# Disabled panel: it was down before us, leave it alone.
		return 0
	fi

	/etc/init.d/veilbridge start >/dev/null 2>&1 || true
	if /etc/init.d/veilbridge running >/dev/null 2>&1; then
		echo "veilbridge: the installed panel was left untouched and restarted." >&2
	else
		echo "veilbridge: could not restart the installed panel." >&2
		echo "  Start it by hand: /etc/init.d/veilbridge start" >&2
	fi
}

# Keep a copy of the binary that currently works, for postinst to restore when
# the package manager ignores our refusal.
rescue_current_binary() {
	rm -f "$RESCUE"
	[ -x "$BIN" ] || return 0
	"$BIN" -version >/dev/null 2>&1 || return 0
	cat "$BIN" > "$RESCUE" 2>/dev/null || rm -f "$RESCUE"
}

case "$(uname -m)" in
	x86_64)          DEV_ARCH=amd64 ;;
	aarch64 | arm64) DEV_ARCH=arm64 ;;
	*)               DEV_ARCH='' ;;
esac

if [ -z "$DEV_ARCH" ]; then
	echo "veilbridge: unsupported CPU: $(uname -m)." >&2
	echo "  Released packages cover x86_64 (amd64) and aarch64 (arm64)." >&2
	echo "  For other targets build from source — see the README." >&2
	rescue_current_binary
	resume_old_service
	exit 1
fi

if [ "$DEV_ARCH" != "$PKG_ARCH" ]; then
	echo "veilbridge: this package is built for $PKG_ARCH, this device is $DEV_ARCH ($(uname -m))." >&2
	echo "  Install the matching file instead: veilbridge_${DEV_ARCH}.ipk / .apk" >&2
	echo "  Or let the installer pick it: wget -qO- .../scripts/install.sh | sh" >&2
	rescue_current_binary
	resume_old_service
	exit 1
fi

rm -f "$RESCUE"
exit 0
