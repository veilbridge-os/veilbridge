# --- Secrets / local config (NEVER commit) ---
*.env
.env*
*.key
*.pem
*.conf.local
config.local.*
secrets/
*_secret*

# --- Go ---
/veilbridged
/bin/
*.exe
*.test
*.out
vendor/

# --- Vue / Node (web/) ---
web/node_modules/
web/dist/
web/.vite/
web/*.tsbuildinfo
npm-debug.log*
yarn-error.log

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Build artifacts of embedded UI ---
internal/api/dist/
/.serena/

# --- Release artifacts (built locally, published by CI) ---
/dist/

# Generated by the Element Plus resolvers on dev/build (unplugin-*). They are
# regenerated deterministically from the source, so keeping them in git would
# only add a diff to every dependency bump.
web/src/auto-imports.d.ts
web/src/components.d.ts
